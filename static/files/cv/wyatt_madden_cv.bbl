      \field{labeltitlesource}{title}
      \field{abstract}{Food availability determines where and how animals use space across a landscape and, therefore, affects the risk of encounters leading to zoonotic spillover. This relationship is evident in Australian flying foxes (Pteropus spp.; fruit bats), where acute food shortages precede clusters of Hendra virus spillovers. Using machine learning, we predicted months of food shortages from climatological and ecological covariates (1996–2022) in subtropical Australia. Overall accuracy in predicting months of low food availability on a test set from 2018 up to 2022 reached 93.33 and 92.59\% based on climatological and bat-level features, respectively. Seasonality and the Oceanic El Niño Index were the most important environmental features, while the number of bats in rescue centres and their body weights were the most important bat-level features. These models support predictive signals up to nine months in advance, facilitating action to mitigate spillover risk.}
      \field{addendum}{\href{https://doi.org/10.1098/rsbl.2025.0371}{Full Paper}}
      \field{issn}{1744-9561}
      \field{journaltitle}{Biology Letters}
      \field{month}{12}
      \field{number}{12}
      \field{title}{Environmental and ecological signals predict food shortages for subtropical populations of {Australian} flying foxes, reservoirs of {Hendra} virus}
